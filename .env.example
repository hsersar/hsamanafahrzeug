# Database
CONNECTION_STRING=Server=(localdb)\\mssqllocaldb;Database=FahrzeugZulassungDb;Trusted_Connection=True;MultipleActiveResultSets=true

# Payment - Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
