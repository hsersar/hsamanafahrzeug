# Environment Variables for Production Deployment
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ===== Application Settings =====
ASPNETCORE_ENVIRONMENT=Production
DOMAIN_NAME=app.example.de

# ===== PostgreSQL Database =====
POSTGRES_USER=hsamanafahrzeug
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=hsamanafahrzeug

# ===== Redis Cache =====
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ===== JWT Authentication =====
# Generate with: openssl rand -base64 64
JWT_KEY=CHANGE_ME_MINIMUM_256_BIT_KEY_HERE_USE_OPENSSL_RAND_BASE64_64
JWT_ISSUER=https://app.example.de
JWT_AUDIENCE=https://app.example.de

# ===== SSL/TLS (Let's Encrypt) =====
LETSENCRYPT_EMAIL=admin@example.de

# ===== CORS Configuration =====
ALLOWED_ORIGINS=https://app.example.de

# ===== IKFZ API Configuration =====
# These are example values - replace with actual API credentials
IKFZ_API_URL=https://api.ikfz.de/v1
IKFZ_API_KEY=YOUR_IKFZ_API_KEY_HERE

# ===== Optional: Docker Registry =====
# Set to true if you want to pull images from GitHub Container Registry
USE_REGISTRY=false
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-token

# ===== Optional: Hetzner Object Storage (S3-compatible) =====
# For automatic backup uploads
# HETZNER_S3_BUCKET=hsamanafahrzeug-backups
# HETZNER_S3_ACCESS_KEY=your-access-key
# HETZNER_S3_SECRET_KEY=your-secret-key
# HETZNER_S3_ENDPOINT=fsn1.your-objectstorage.com

# ===== Optional: Notifications =====
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===== Optional: Monitoring =====
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
