@model FahrzeugZulassung.Application.DTOs.Email.AuftragAbgeschlossenEmailModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Auftrag abgeschlossen";
}

<div style="background-color: #10b981; color: white; padding: 30px; text-align: center; border-radius: 8px; margin: 20px 0;">
    <div style="font-size: 60px; margin-bottom: 10px;">🎉</div>
    <h2 style="margin: 0; color: white;">Auftrag erfolgreich abgeschlossen!</h2>
</div>

<p>Hallo @Model.KundenName,</p>

<p>Ihr Auftrag wurde erfolgreich abgeschlossen!</p>

<div style="background-color: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <h3 style="margin-top: 0;">Zusammenfassung</h3>
    <p><strong>Auftragstyp:</strong> @Model.AuftragTyp</p>
    @if (!string.IsNullOrEmpty(Model.Kennzeichen))
    {
        <p><strong>Kennzeichen:</strong> @Model.Kennzeichen</p>
    }
    <p><strong>Abgeschlossen am:</strong> @Model.AbschlussDatum.ToString("dd.MM.yyyy HH:mm")</p>
</div>

<p>Wir hoffen, Sie waren mit unserem Service zufrieden.</p>

<center>
    <a href="@Model.BewertungsUrl" class="button">Jetzt bewerten</a>
</center>

<p>Vielen Dank für Ihr Vertrauen!</p>

<p>
    Mit freundlichen Grüßen<br>
    Ihr KFZ-Zulassungsservice Team
</p>
