@model FahrzeugZulassung.Application.DTOs.Email.StatusUpdateEmailModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Statusupdate";
}

<h2>Status-Update zu Ihrem Auftrag</h2>

<p>Hallo @Model.KundenName,</p>

<p>der Status Ihres Auftrags hat sich geändert:</p>

<div style="background-color: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
        <div style="flex: 1; text-align: center;">
            <div style="background-color: #9ca3af; color: white; padding: 10px; border-radius: 6px;">
                @Model.AlterStatus
            </div>
        </div>
        <div style="flex: 0 0 40px; text-align: center; font-size: 24px;">
            →
        </div>
        <div style="flex: 1; text-align: center;">
            <div style="background-color: #10b981; color: white; padding: 10px; border-radius: 6px;">
                @Model.NeuerStatus
            </div>
        </div>
    </div>
    
    <div style="background-color: #e5e7eb; height: 10px; border-radius: 5px; margin-top: 20px;">
        <div style="background-color: #2563eb; height: 10px; border-radius: 5px; width: @Model.Fortschritt%;"></div>
    </div>
    <p style="text-align: center; margin: 5px 0 0 0; font-size: 12px;">Fortschritt: @Model.Fortschritt%</p>
</div>

@if (!string.IsNullOrEmpty(Model.Handlungsaufforderung))
{
    <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; margin: 20px 0;">
        <strong>⚠️ Erforderliche Aktion:</strong><br>
        @Model.Handlungsaufforderung
    </div>
}

<center>
    <a href="@Model.TrackingUrl" class="button">Details ansehen</a>
</center>

<p>
    Mit freundlichen Grüßen<br>
    Ihr KFZ-Zulassungsservice Team
</p>
