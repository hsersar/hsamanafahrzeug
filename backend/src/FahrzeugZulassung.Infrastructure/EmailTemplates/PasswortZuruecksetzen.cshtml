@model FahrzeugZulassung.Application.DTOs.Email.PasswortZuruecksetzenEmailModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Passwort zurücksetzen";
}

<h2>Passwort zurücksetzen</h2>

<p>Hallo @Model.KundenName,</p>

<p>Sie haben eine Anfrage zum Zurücksetzen Ihres Passworts gestellt.</p>

<p>Klicken Sie auf den folgenden Link, um ein neues Passwort zu vergeben:</p>

<center>
    <a href="@Model.ResetLink" class="button">Passwort zurücksetzen</a>
</center>

<div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; margin: 20px 0;">
    <strong>⚠️ Sicherheitshinweis:</strong><br>
    Dieser Link ist bis <strong>@Model.GueltigBis.ToString("dd.MM.yyyy HH:mm")</strong> gültig.<br>
    Falls Sie diese Anfrage nicht gestellt haben, ignorieren Sie diese E-Mail bitte.
</div>

<p>
    Mit freundlichen Grüßen<br>
    Ihr KFZ-Zulassungsservice Team
</p>
